# Copie para `.env` na raiz (o `.env` está no .gitignore).
#
# Este arquivo é do docker compose, que sobe apenas o Postgres. As variáveis da
# API e do frontend ficam em apps/backend/.env.example e apps/frontend/.env.example.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=smart_retention
POSTGRES_PORT=5432
