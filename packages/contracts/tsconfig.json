{
  "extends": "@repo/tsconfig/nest.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": ".",
    // O pacote é TS puro (sem API de Node), então não carrega tipos globais.
    "types": [],
    // Diferente do app Nest, este pacote é consumido direto pelo Node (ESM),
    // então os imports relativos carregam a extensão `.js` no fonte.
    "module": "nodenext",
    "moduleResolution": "nodenext"
  },
  "include": ["src", "test", "eslint.config.mjs"],
  "exclude": ["node_modules", "dist"]
}
