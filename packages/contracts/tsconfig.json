{
  "extends": "@repo/tsconfig/nest.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": ".",
    // O pacote é TS puro e não usa a API de Node, então não carrega tipos globais.
    "types": [],
    // Este pacote é consumido diretamente pelo Node (ESM), então os imports
    // relativos trazem a extensão `.js` no fonte.
    "module": "nodenext",
    "moduleResolution": "nodenext"
  },
  "include": ["src", "test", "eslint.config.mjs"],
  "exclude": ["node_modules", "dist"]
}
