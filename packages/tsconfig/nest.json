{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "NestJS (ESM)",
  // `paths` fica no tsconfig de cada pacote. Os caminhos são relativos ao arquivo
  // que os declara, então movê-los para cá quebraria os aliases.
  "extends": "./base.json",
  "compilerOptions": {
    // `bundler` permite escrever `@/app.module` sem extensão. Depois do `tsc`, o
    // build do Nest roda `tsc-alias`, que reescreve os aliases e adiciona o `.js`
    // exigido pelo ESM do Node.
    "module": "esnext",
    "moduleResolution": "bundler",
    "target": "es2023",
    "lib": ["es2023"],
    "types": ["node"],

    // `outDir` fica no tsconfig de cada pacote. Em um config estendido, caminhos
    // relativos partem do arquivo que declara a opção, não do pacote.
    "declaration": true,
    "removeComments": true,
    "sourceMap": true,

    // Decorators do NestJS.
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,

    // O Nest instancia propriedades via DI, não no construtor.
    "strictPropertyInitialization": false
  }
}
