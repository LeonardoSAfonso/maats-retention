{
  "extends": "@repo/tsconfig/nest.json",
  "compilerOptions": {
    // Os `paths` ficam aqui (e não no pacote compartilhado) porque resolvem
    // relativo a este arquivo.
    "paths": {
      "@/*": ["./src/*"]
    },
    "types": ["vitest/globals", "node"],

    // Relativo a este arquivo (não ao config compartilhado).
    "outDir": "./dist"
  },
  "include": ["src", "test", "*.config.ts"],
  "exclude": ["node_modules", "dist"]
}
