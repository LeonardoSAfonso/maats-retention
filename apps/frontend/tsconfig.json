{
  "extends": "@repo/tsconfig/nextjs.json",
  "include": [
    "next-env.d.ts",
    "**/*.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": ["node_modules"],
  "compilerOptions": {
    // Resolve relativo a este arquivo, por isso fica aqui e não no pacote.
    "paths": {
      "@/*": ["./src/*"]
    },
    "types": ["node", "react", "react-dom"]
  }
}
